	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Koma Desk Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.mida.komadesk.project</string>
				<string>com.mida.panels.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Comic Book Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>cx.c3.cbr-archive</string>
				<string>cx.c3.cbz-archive</string>
				<string>com.mida.komadesk.cb7-archive</string>
			</array>
		</dict>
	</array>

	<!-- A project is a folder Finder treats as one file. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.mida.komadesk.project</string>
			<key>UTTypeDescription</key>
			<string>Koma Desk Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>komadesk</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- .cbr / .cbz aren't system-declared types, so Koma Desk imports the
	     identifiers other comic readers already use. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<!-- Projects from before the app was Koma Desk. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.mida.panels.project</string>
			<key>UTTypeDescription</key>
			<string>Koma Desk Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>panelsproject</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>cx.c3.cbr-archive</string>
			<key>UTTypeDescription</key>
			<string>Comic Book RAR Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.rarlab.rar-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbr</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>cx.c3.cbz-archive</string>
			<key>UTTypeDescription</key>
			<string>Comic Book ZIP Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.mida.komadesk.cb7-archive</string>
			<key>UTTypeDescription</key>
			<string>Comic Book 7-Zip Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>org.7-zip.7-zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cb7</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
